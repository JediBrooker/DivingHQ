                <data android:pathPrefix="/accreditation/" />
                <data android:path="/charges" />
                <data android:pathPrefix="/charges/" />
                <data android:path="/fines" />
                <data android:pathPrefix="/fines/" />
                <data android:path="/classes" />
                <data android:pathPrefix="/classes/" />
                <data android:path="/donate" />
                <data android:pathPrefix="/donate/" />
                <data android:path="/guide" />
                <data android:pathPrefix="/guide/" />
                <data android:path="/privacy" />
                <data android:pathPrefix="/privacy/" />
                <data android:path="/terms" />
                <data android:pathPrefix="/terms/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
