# =============================================================
# DivingHQ — environment variables
#
# Copy to `.env` and fill in real values. `.env` is gitignored —
# never commit it. The server fail-closes on missing JWT_SECRET;
# everything else has sensible defaults but you should set them
# explicitly in production.
#
# Generate a strong JWT secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# =============================================================

# --- Server ---
PORT=3000
# Where the SPA + API speak from. Used by CORS + Socket.IO.
CORS_ORIGIN=http://localhost:5173
# Public base URL of the deployed app (used in password-reset
# links and meet-program PDFs). Defaults to CORS_ORIGIN if unset.
# Its origin also stands in for https://divinghq.app in each page's
# canonical link, robots.txt and sitemap.xml (those keep
# divinghq.app when this is unset).
APP_BASE_URL=http://localhost:5173
# Max concurrent Socket.IO connections per client IP (defence-in-depth
# against connection-flood DoS). Default 200 — generous, since a whole
# venue of spectators can share one NAT IP. Raise for very large meets
# behind a single egress IP; set 0 to disable the cap entirely.
MAX_SOCKETS_PER_IP=200

# --- Account creation ---
# SIGNUPS_ENABLED is RETIRED. Public sign-ups are now the 'signups' feature
# flag (migration 086, seeded ON), toggled at /admin/features. Setting this env
# var does nothing; the note is here so nobody goes looking for a var that no
# longer wires up.

# --- Feature flags (payments, classes, signups, maintenance) ---
# These are NOT env vars. They live in the feature_flags table (migrations
# 085/086) and a system admin toggles them at /admin/features, no restart, no
# deploy. Ship state: payments OFF, classes OFF, signups ON, maintenance OFF.
# Payments additionally needs its flag on AND the Stripe keys below.
#
# FEATURE_FLAGS_ON is a break-glass override that forces flags on regardless
# of the table. The e2e suite uses it (see playwright.config.js); production
# should not. It can only force ON, never off.
# FEATURE_FLAGS_ON=payments,classes,signups

# --- Payments (Stripe — platform is merchant of record) ---
# Payments need BOTH the 'payments' feature flag (above) and the keys below.
# With either missing, every checkout route returns 503 ("coming soon" mode).
# Turning the flag off does NOT kill the webhook: deliveries for charges
# already in flight keep settling, so nothing gets stranded mid-checkout.
# BOTH keys are required together — the server refuses to boot with a secret
# key but no webhook secret, because checkouts would charge payers while every
# completion webhook fails (money taken, nothing fulfilled).
#   1. STRIPE_SECRET_KEY: the platform account's secret key (sk_live_… /
#      sk_test_…) from the Stripe dashboard.
#   2. STRIPE_WEBHOOK_SECRET: register a STANDARD webhook endpoint for
#      https://<your-domain>/webhooks/stripe (events: checkout.session.completed,
#      checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#      checkout.session.expired, charge.refunded, charge.dispute.created,
#      charge.dispute.closed) and paste its signing secret (whsec_…).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#   3. PAYOUTS (Stripe Connect): clubs/federations receive their balance via
#      automatic Connect transfers to a recipient-only connected account. This
#      needs Connect enabled on the platform account (Stripe dashboard →
#      Connect → platform setup → "marketplace" business model). No extra
#      secret — the same STRIPE_SECRET_KEY is used. Recipients onboard via
#      Stripe-hosted onboarding; the app never stores bank details.
# Where FAILED-payout alerts go (a transfer that Stripe rejected). Defaults to
# EMAIL_FROM when unset.
# PLATFORM_OPS_EMAIL=

# --- Database (PostgreSQL) ---
# DATABASE_URL takes precedence if set. Otherwise the libpq-style
# DB_* vars below are used.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
# The dev database. `npm test` and the e2e suite read this too, and they
# refuse any name without "test" in it, so run them with
# DB_DATABASE=divinghq_test in front (see README, End-to-end tests).
DB_DATABASE=divinghq
DB_USER=postgres
DB_PASSWORD=

# --- JWT (REQUIRED) ---
# Boot fails closed if unset or equal to the well-known placeholder.
# Warning emitted at <32 chars; rotate to >=32 random chars in prod.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY=8h

# --- Email — Cloudflare Email Sending (optional) ---
# Transactional email goes through the Cloudflare Email Sending REST
# API. When CF_ACCOUNT_ID or CF_EMAIL_TOKEN is blank every email
# helper silently no-ops (dev mode) — the app still runs without
# email. To wire up password resets / role-decision notifications /
# meet emails fill all three in.
#
# CF_ACCOUNT_ID  — your Cloudflare account ID.
# CF_EMAIL_TOKEN — API token scoped to Email Sending.
CF_ACCOUNT_ID=
CF_EMAIL_TOKEN=
# From-address shown to recipients. Must be an address on a domain
# onboarded to Cloudflare Email Sending.
EMAIL_FROM=

# --- Support contact ---
# Where people reach a person. Used as the Reply-To on every email (so
# replying to a claim or suspension notice lands somewhere), in the
# "contact support" lines of error messages, and in the SPA's home /
# login / privacy / terms footers (served by GET /api/public-config).
# Defaults to support@divinghq.app, which is the hosted service's inbox:
# if you run your own copy, set this to an address you actually read.
SUPPORT_EMAIL=support@divinghq.app

# --- Metrics (optional) ---
# A request for /metrics that came through Cloudflare (it carries cf-ray
# or cf-connecting-ip) is always a 404 unless it has
# `Authorization: Bearer <METRICS_TOKEN>`. A Cloudflare Tunnel forwards
# every path to the app, so a firewall on port 3000 does nothing for it.
#
# Direct requests (Prometheus scraping the app on the same box): with
# METRICS_TOKEN set they need the bearer, and get a 401 without it.
# With METRICS_TOKEN unset, /metrics is open in dev, but in production
# (NODE_ENV=production) it fails closed (401) unless you opt in with
# METRICS_PUBLIC=true. See lib/metrics-access.js.
METRICS_TOKEN=
# METRICS_PUBLIC=true   # tokenless direct scrapes in production. Only
                        # safe when nothing outside the box can reach
                        # the app's port without going through Cloudflare.

# --- Offline-resilience ---
# Client-side outbox for write actions. When enabled, scores +
# other meet-time writes are queued in IndexedDB and survive
# network outages, tab reloads, and offline gaps up to 72 hours.
# Server-side conflict resolution policy. 'auto' (default) keeps
# the existing last-write-wins behaviour for ON CONFLICT DO UPDATE
# on the scores table. 'operator' fires conflict_pending socket
# events and requires explicit resolution via the Control Room
# review tray (P4 work — don't flip to 'operator' until that ships).
OFFLINE_CONFLICT_RESOLUTION=auto

# --- Web Push / VAPID (optional) ---
# Generate a key pair once per deployment:
#     node scripts/generate-vapid-keys.js
# Rotating these invalidates every existing browser subscription,
# so set once and persist. When VAPID_PUBLIC_KEY is unset, the
# push backend silently no-ops — the app still runs and falls
# through to the in-app socket banner. SUBJECT is the contact
# the push service uses to reach you if your sender misbehaves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- DiveRecorder archive import (optional) ---
# The Results Archive (/results-archive) browses historical results
# mined from diverecorder.co.uk into the dr_* tables. A sysadmin can
# trigger an incremental "pull new meets" run from that page; set the
# cadence below to ALSO run it automatically on a schedule. Unset/0
# disables the scheduled sync (the manual button still works). Full
# backfills are run from the CLI: `npm run import:diverecorder`.
# Any number of hours works, 720 for monthly included.
# DR_IMPORT_SYNC_HOURS=24
# Politeness delay between source requests for server-side runs (ms):
# DR_IMPORT_DELAY_MS=1000

# --- Translation tooling (optional) ---
# Only needed to run `npm run translate` (scripts/translate-locales.js),
# which AI-translates new/changed en.json keys into every locale. Not
# used by the running app. The script loads this .env via dotenv.
#
# Claude is the default provider whenever ANTHROPIC_API_KEY is set
# (even if OPENAI_API_KEY is also present). Just set this one line to
# translate with Claude:
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-5):
# ANTHROPIC_MODEL=claude-sonnet-4-5
#
# Alternative backend — used only when OPENAI_API_KEY is set AND
# ANTHROPIC_API_KEY is absent. Force it with TRANSLATE_PROVIDER=openai
# if you have both keys. Defaults to model gpt-5-mini.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# --- PDF fonts (optional, usually nothing to set) ---
# The PDF exports (program, start list, score sheet, results, judge
# ranking) print each script in its own Noto font, found where the Debian
# packages put them:
#   sudo apt install fonts-noto-core fonts-noto-cjk
#   fonts-noto-core  /usr/share/fonts/truetype/noto  Latin, Cyrillic, Greek
#                    (NotoSans-*), Arabic (NotoSansArabic-*), Hebrew
#                    (NotoSansHebrew-*)
#   fonts-noto-cjk   /usr/share/fonts/opentype/noto  Chinese, Japanese,
#                    Korean (NotoSansCJK-Regular.ttc / -Bold.ttc)
# Whatever isn't installed falls back to PDFKit's Helvetica the old way:
# Łukasz to Lukasz, Иван to Ivan, CJK / Arabic / Hebrew to "?", and a
# header in a language the fonts can't print comes out in English. The
# app runs fine with neither package. Restart after installing.
#
# Look somewhere else (colon-separated, same file names), or "none" to
# turn the fonts off:
# PDF_FONT_DIR=/srv/fonts
# Pick the Latin/Cyrillic/Greek files by hand. Wins over PDF_FONT_DIR for
# those scripts; a single wide font here still covers what it covers.
# PDF_FONT_REGULAR=/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/noto/NotoSans-Bold.ttf
# PDF_FONT_ITALIC=/usr/share/fonts/truetype/noto/NotoSans-Italic.ttf
# Han characters look different per region. Chinese names use the
# Simplified Chinese face unless this says TC, HK, JP or KR (kana always
# use JP and Hangul KR, whatever it says):
# PDF_FONT_CJK_REGION=SC

# --- Backups and ops status (optional) ---
# scripts/ops/backup-db.sh (nightly) and restore-check.sh (weekly) read
# the DB settings above plus these. ops/backups/README.md has the whole
# story, install steps and the restore runbook.
#
# Where the scripts and deploy.sh leave backup.json, restore-check.json
# and deploy.json, which GET /api/ops/status reads. The app reads this
# too, so set it here if you move it. Keep it outside the repo.
# OPS_STATE_DIR=/var/lib/divinghq
# BACKUP_DIR=/var/backups/divinghq
# BACKUP_KEEP_LOCAL=14
# BACKUP_PASSPHRASE_FILE=/root/.divinghq-backup-passphrase
#
# Off-site copies on Cloudflare R2, encrypted with the passphrase file
# before they leave the box. All four or none; the token needs Object
# Read & Write on that one bucket. Only the backup script reads them.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Native push (optional until provisioned). Dedicated credentials outside checkout.
# APNs key must be scoped to app.divinghq.mobile and the listed environment(s).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_ENVIRONMENTS=production
# Firebase service-account JSON for the DivingHQ Android project only.
FCM_SERVICE_ACCOUNT_PATH=
